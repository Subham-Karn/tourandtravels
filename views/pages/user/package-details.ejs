<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pkg.packageName %> | Bihar Travel</title>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/package-details.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

    <%- include("../../partials/user/navbar", {user}) %>

    <main class="package-detail-container">
        <div class="package-hero">
            <img src="<%= pkg.packageImage %>" alt="<%= pkg.packageName %>">
            <div class="overlay"></div>
            <div class="hero-content">
                <h1><%= pkg.packageName %></h1>
                <div class="rating">
                    <% for(let i = 1; i <= 5; i++){ %>
                        <% if(i <= Math.round(pkg.packageRating)){ %>
                            <i class="fas fa-star"></i>
                        <% } else { %>
                            <i class="far fa-star"></i>
                        <% } %>
                    <% } %>
                    <span>(<%= pkg.packageRating %>/5)</span>
                </div>
                <div class="price">₹<%= pkg.packagePrice.toLocaleString() %></div>
            </div>
        </div>

        <div class="content-wrapper">
            <section class="package-info">
                <h2>About This Package</h2>
                <p><%= pkg.packageDescription %></p>
            </section>

            <section class="booking-section" id="book">
                <h2>Book This Package</h2>

                <% if(user){ %>

                    <form action="/booking" method="POST" class="booking-form">

                        <input type="hidden" name="destination" value="<%= pkg.packageName %>">

                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" value="<%= user.fullName %>" readonly>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" value="<%= user.email %>" readonly>
                        </div>

                        <div class="form-group">
                            <label>Number of Guests</label>
                            <input type="number" name="guests" min="1" placeholder="Number of Guests" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Arrival Date</label>
                                <input type="date" name="arrival" required>
                            </div>
                            <div class="form-group">
                                <label>Leaving Date</label>
                                <input type="date" name="leaving" required>
                            </div>
                        </div>

                        <button type="submit" class="btn-book">
                            <i class="fas fa-check-circle"></i> Confirm Booking
                        </button>

                    </form>

                <% } else { %>

                    <div class="login-prompt">
                        <i class="fas fa-lock"></i>
                        <h3>Login Required</h3>
                        <p>Please login to book this package.</p>
                        <a href="/auth/login" class="btn">Login Now</a>
                    </div>

                <% } %>

            </section>
        </div>
    </main>

    <%- include("../../partials/user/footer") %>
    <script src="/js/script.js"></script>
</body>
</html>