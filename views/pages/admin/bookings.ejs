<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel | <%= pageName %></title>

    <link rel="stylesheet" href="/css/admin/index.css">
    <link rel="stylesheet" href="/css/admin/bookings.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
</head>
<body>

<%- include("../../partials/admin/slider",{user,currentPath}) %>

<main>

    <!-- Header -->

    <section class="page-header">

        <div>
            <h1>Bookings</h1>
            <p>Manage customer tour bookings.</p>
        </div>

    </section>

    <!-- Statistics -->

    <section class="stats">

        <div class="card">
            <p>Total Bookings</p>
            <h1><%= bookings.length %></h1>
        </div>

        <div class="card">
            <p>Confirmed</p>
            <h1><%= bookings.filter(b=>b.bookingStatus==="Confirmed").length %></h1>
        </div>

        <div class="card">
            <p>Pending</p>
            <h1><%= bookings.filter(b=>b.bookingStatus==="Pending").length %></h1>
        </div>

        <div class="card">
            <p>Cancelled</p>
            <h1><%= bookings.filter(b=>b.bookingStatus==="Cancelled").length %></h1>
        </div>

    </section>

    <!-- Filter -->

    <section class="filter-box">

        <form action="/admin/bookings" method="GET">

            <input
                type="text"
                name="q"
                placeholder="Search by destination"
                value="<%= q || '' %>"
            >

            <select name="status">

                <option value="all">All Status</option>

                <option value="Pending" <%= status==="Pending" ? "selected":"" %>>
                    Pending
                </option>

                <option value="Confirmed" <%= status==="Confirmed" ? "selected":"" %>>
                    Confirmed
                </option>

                <option value="Completed" <%= status==="Completed" ? "selected":"" %>>
                    Completed
                </option>

                <option value="Cancelled" <%= status==="Cancelled" ? "selected":"" %>>
                    Cancelled
                </option>

            </select>

        </form>

    </section>

    <!-- Table -->

    <section class="table-container">

        <table>

            <thead>

                <tr>

                    <th>#</th>
                    <th>Destination</th>
                    <th>Guests</th>
                    <th>Arrival</th>
                    <th>Leaving</th>
                    <th>Total Price</th>
                    <th>Status</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

            <% if(bookings.length){ %>

                <% bookings.forEach((booking,index)=>{ %>

                    <tr>

                        <td><%= index+1 %></td>

                        <td><%= booking.destination %></td>

                        <td><%= booking.guests %></td>

                        <td>
                            <%= new Date(booking.arrivalDate).toLocaleDateString() %>
                        </td>

                        <td>
                            <%= new Date(booking.leavingDate).toLocaleDateString() %>
                        </td>

                        <td>
                            ₹<%= booking.totalPrice.toLocaleString() %>
                        </td>

                        <td>

                            <span class="status <%= booking.bookingStatus.toLowerCase() %>">
                                <%= booking.bookingStatus %>
                            </span>

                        </td>

                        <td>

                            <a href="/admin/bookings/<%= booking._id %>"
                            class="action view">

                                <i class="fa-solid fa-eye"></i>

                            </a>

                            <a href="/admin/bookings/delete/<%= booking._id %>"
                            class="action delete">

                                <i class="fa-solid fa-trash"></i>

                            </a>

                        </td>

                    </tr>

                <% }) %>

            <% }else{ %>

                <tr>

                    <td colspan="8" class="empty">

                        <i class="fa-solid fa-calendar-xmark"></i>

                        <h2>No Bookings Found</h2>

                        <p>No customer bookings available.</p>

                    </td>

                </tr>

            <% } %>

            </tbody>

        </table>

    </section>

</main>

</body>
</html>