<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel | Add Package</title>
    <link rel="stylesheet" href="/css/admin/index.css">
    <link rel="stylesheet" href="/css/admin/add-package.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

    <%- include("../../partials/admin/slider",{user,currentPath}) %>

    <% if(typeof error !== "undefined" && error){ %>
        <div class="alert error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <main>
        <section class="page-header">
            <div>
                <h1>Add Package</h1>
                <p>Create a new travel package.</p>
            </div>
            <a href="/admin/packages" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </section>

        <form action="/admin/packages/add" method="POST" enctype="multipart/form-data" class="form-card">
            <div class="grid">
                <div class="form-group">
                    <label>Package Name</label>
                    <input type="text" name="packageName" placeholder="Enter Package Name"
                        value="<%= values?.packageName || '' %>" required>
                </div>

                <div class="form-group">
                    <label>Package Price (₹)</label>
                    <input type="number" name="packagePrice" placeholder="Enter Price"
                        value="<%= values?.packagePrice || '' %>" required>
                </div>

                <div class="form-group">
                    <label>Package Rating</label>
                    <input type="number" step="0.1" min="0" max="5" name="packageRating"
                        value="<%= values?.packageRating || 5 %>" required>
                </div>

                <div class="form-group full">
                    <label>Package Image</label>
                    <input type="file" name="packageImage" accept="image/*" required>
                    <img id="preview" style="display:none; margin-top:15px; width:220px; border-radius:10px;">
                </div>

                <div class="form-group full">
                    <label>Package Description</label>
                    <textarea name="packageDescription" rows="6" placeholder="Write package description..."
                        required><%= values?.packageDescription || '' %></textarea>
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="save-btn">
                    <i class="fa-solid fa-floppy-disk"></i> Save Package
                </button>
                <a href="/admin/packages" class="cancel-btn">Cancel</a>
            </div>
        </form>
    </main>

    <script src="/js/admin/add-package.js"></script>
</body>
</html>