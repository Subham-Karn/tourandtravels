<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin/index.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <title>Admin Panel | <%= pageName %>
    </title>
</head>

<body>
    <%- include("../../partials/admin/slider" , {user , currentPath}) %>
        <main>

            <!-- Heading -->
            <section class="page-header">
                <h1>Dashboard</h1>
                <p>Analyze your platform activity.</p>
            </section>

            <!-- Statistics -->
            <section class="stats">

                <div class="card">
                    <p>Total Users</p>
                    <h1><%= totalUsers %></h1>
                </div>

                <div class="card">
                    <p>Total Bookings</p>
                    <h1><%= totalBookings %></h1>
                </div>

                <div class="card">
                    <p>Total Packages</p>
                    <h1><%= totalPackages %></h1>
                </div>

                <div class="card">
                    <p>Total Inquiries</p>
                    <h1><%= totalInquiries %></h1>
                </div>

            </section>

            <!-- Recent Bookings -->
            <section class="recent-bookings">

                <div class="table-header">
                    <h2>Recent Bookings</h2>
                    <a href="/admin/bookings">View All</a>
                </div>

                <table>

                    <thead>

                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Destination</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if(recentBookings && recentBookings.length){ %>

                            <% recentBookings.forEach((booking, index) => { %>

                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= booking.userId?.fullName || "N/A" %></td>
                                    <td><%= booking.destination %></td>
                                    <td><%= new Date(booking.createdAt).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status <%= booking.bookingStatus.toLowerCase() %>">
                                            <%= booking.bookingStatus %>
                                        </span>
                                    </td>
                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="5" style="text-align:center;padding:20px;color:#888;">
                                    No recent bookings found.
                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </section>

        </main>
        <script src="/js/admin/dasboard.js"></script>
</body>

</html>