<section class="packages" id="packages">

    <h1 class="heading">

        <span>P</span>
        <span>A</span>
        <span>C</span>
        <span>K</span>
        <span>A</span>
        <span>G</span>
        <span>E</span>
        <span>S</span>

    </h1>

    <div class="box-container">

        <% if(packages && packages.length){ %>

            <% packages.forEach(pkg=>{ %>

                <div class="box">

                    <img
                        src="<%= pkg.packageImage %>"
                        alt="<%= pkg.packageName %>"
                    >

                    <div class="content">

                        <h3>

                            <i class="fas fa-map-marker-alt"></i>

                            <%= pkg.packageName %>

                        </h3>

                        <p>
                            <%= pkg.packageDescription.length > 100
                                ? pkg.packageDescription.substring(0,100) + "..."
                                : pkg.packageDescription %>
                        </p>

                        <div class="stars">

                            <% for(let i = 1; i <= 5; i++){ %>
                                <% if(i <= Math.round(pkg.packageRating)){ %>
                                    <i class="fas fa-star"></i>
                                <% } else { %>
                                    <i class="far fa-star"></i>
                                <% } %>
                            <% } %>

                        </div>

                        <div class="price">

                            ₹<%= pkg.packagePrice.toLocaleString() %>

                        </div>

                        <a href="/package/<%= pkg._id %>" class="btn">
                            View Details
                        </a>

                        <a href="#" class="btn book-now-btn" style="background:#28a745;" data-package="<%= pkg.packageName %>">
                            <i class="fas fa-calendar-check"></i> Book Now
                        </a>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div style="text-align:center;padding:2rem;width:100%;">
                <h2 style="color:#666;font-size:2rem;">No Packages Available</h2>
                <p style="color:#999;font-size:1.2rem;">Check back later for exciting travel packages.</p>
            </div>

        <% } %>

    </div>

</section>