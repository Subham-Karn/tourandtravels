<section class="book" id="book">

    <!-- Section Heading -->

    <h1 class="heading">

        <span>B</span>
        <span>O</span>
        <span>O</span>
        <span>K</span>

        <span class="space"></span>

        <span>N</span>
        <span>O</span>
        <span>W</span>

    </h1>

    <div class="row">

        <!-- Left Image -->

        <div class="image">

            <img src="/images/travel.avif" alt="Book Your Tour">

        </div>

        <!-- Booking Form -->

        <form action="/booking" method="POST">

            <div class="inputBox">

                <h3>Destination</h3>

                <input type="text" name="destination" placeholder="Enter Destination" required>

            </div>

            <div class="inputBox">

                <h3>Guests</h3>

                <input type="number" name="guests" min="1" placeholder="Number of Guests" required>

            </div>

            <div class="inputBox">

                <h3>Arrival Date</h3>

                <input type="date" name="arrival" required>

            </div>

            <div class="inputBox">

                <h3>Leaving Date</h3>

                <input type="date" name="leaving" required>

            </div>

            <button type="submit" class="btn">

                Book Now

            </button>

        </form>

    </div>

</section>