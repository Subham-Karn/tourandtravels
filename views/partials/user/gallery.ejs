<section class="gallery" id="gallery">

    <h1 class="heading">
        <span>G</span>
        <span>A</span>
        <span>L</span>
        <span>L</span>
        <span>E</span>
        <span>R</span>
        <span>Y</span>
    </h1>

    <div class="box-container">

        <% if(galleries.length){ %>

            <% galleries.forEach(gallery => { %>

                <div class="box">

                    <img
                        src="<%= gallery.galleryImage %>"
                        alt="<%= gallery.galleryName %>">

                    <div class="content">

                        <h3>
                            <%= gallery.galleryName %>
                        </h3>

                        <p>
                            <i class="fas fa-map-marker-alt"></i>
                            <%= gallery.location %>, <%= gallery.state || '' %>
                        </p>

                        <p>
                            <%= gallery.description.length > 100
                                ? gallery.description.substring(0,100) + "..."
                                : gallery.description %>
                        </p>

                        <div class="stars" style="margin: 8px 0;">
                            <% for(let i = 1; i <= 5; i++){ %>
                                <% if(i <= Math.round(gallery.rating)){ %>
                                    <i class="fas fa-star"></i>
                                <% } else { %>
                                    <i class="far fa-star"></i>
                                <% } %>
                            <% } %>
                        </div>

                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                            <a href="/gallery/<%= gallery._id %>" class="btn">
                                Explore Now
                            </a>

                            <% if(user){ %>
                                <button class="btn book-gallery-index-btn"
                                    style="background:#28a745;border:none;cursor:pointer;"
                                    data-destination="<%= gallery.galleryName %>, <%= gallery.location %>">
                                    <i class="fas fa-calendar-check"></i> Book
                                </button>
                            <% } else { %>
                                <a href="/auth/login" class="btn" style="background:#28a745;">
                                    <i class="fas fa-lock"></i> Login to Book
                                </a>
                            <% } %>
                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <h2>No Gallery Found</h2>

        <% } %>

    </div>

</section>