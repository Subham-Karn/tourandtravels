<section class="contact" id="contact">

    <!-- Section Heading -->

    <h1 class="heading">

        <span>C</span>
        <span>O</span>
        <span>N</span>
        <span>T</span>
        <span>A</span>
        <span>C</span>
        <span>T</span>

    </h1>

    <div class="row">

        <!-- Contact Image -->

        <div class="image">

            <img
                src="/images/travel3.webp"
                alt="Contact Bihar Travel"
            >

        </div>

        <!-- Contact Form -->

        <form action="/contact" method="POST">

            <div class="inputBox">

                <input
                    type="text"
                    name="name"
                    placeholder="Full Name"
                    required
                >

                <input
                    type="email"
                    name="email"
                    placeholder="Email Address"
                    required
                >

            </div>

            <div class="inputBox">

                <input
                    type="tel"
                    name="phone"
                    placeholder="Phone Number"
                    required
                >

                <input
                    type="text"
                    name="subject"
                    placeholder="Subject"
                    required
                >

            </div>

            <textarea
                name="message"
                rows="8"
                placeholder="Write your message..."
                required
            ></textarea>

            <button
                type="submit"
                class="btn"
            >

                Send Message

            </button>

        </form>

    </div>

</section>