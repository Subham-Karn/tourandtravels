<header class="header">

    <div id="menu-bar" class="fas fa-bars"></div>

    <a href="/" class="logo">
        <span>B</span>ihar Travel
    </a>

    <nav class="navbar">
        <a href="/">Home</a>
        <a href="#packages">Packages</a>
        <a href="#services">Services</a>
        <a href="#gallery">Gallery</a>
        <a href="#review">Reviews</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="icons">

        <i class="fas fa-search" id="search-btn"></i>

        <% if(user){ %>

            <div class="profile-dropdown">

                <div class="profile-circle">
                    <%= user.fullName.charAt(0).toUpperCase() %>
                </div>

                <div class="dropdown-menu">

                    <div class="profile-info">
                        <h3><%= user.fullName %></h3>
                        <p><%= user.email %></p>

                        <hr>

                        <p><strong>Age :</strong> <%= user.age %></p>
                        <p><strong>Gender :</strong> <%= user.gender %></p>
                    </div>

                    <a href="/my-bookings">
                        <i class="fas fa-suitcase"></i>
                        My Bookings
                    </a>

                    <a href="/profile">
                        <i class="fas fa-user"></i>
                        Profile
                    </a>

                    <a href="/auth/logout" class="logout">
                        <i class="fas fa-sign-out-alt"></i>
                        Logout
                    </a>

                </div>

            </div>

        <% } else { %>

            <div class="auth-buttons">

                <a href="/auth/login" class="login-btn">
                    Login
                </a>

                <a href="/auth/signup" class="signup-btn">
                    Sign Up
                </a>

            </div>

        <% } %>

    </div>

    <form class="search-bar-container" action="/search" method="GET">

        <input
            type="search"
            name="q"
            id="search-bar"
            placeholder="Search packages & destinations..."
            required>

        <button type="submit" class="fas fa-search" style="background:none;border:none;color:#fff;cursor:pointer;font-size:3rem;margin-left:1.5rem;"></button>

    </form>

</header>