<section class="review" id="review">

    <h1 class="heading">

        <span>R</span>
        <span>E</span>
        <span>V</span>
        <span>I</span>
        <span>E</span>
        <span>W</span>

    </h1>

    <% const reviews = [

        {
            image:"reviimg.webp",
            name:"H. C. Verma"
        },

        {
            image:"reviimg2.jpg",
            name:"Subrata Roy"
        },

        {
            image:"reviimg3.png",
            name:"Gautam Chikermant"
        },

        {
            image:"reviimg4.jpg",
            name:"Tenzin Gyatso"
        }

    ]; %>

    <div class="swiper-container review-slider">

        <div class="swiper-wrapper">

            <% reviews.forEach(review=>{ %>

                <div class="swiper-slide">

                    <div class="box">

                        <img
                            src="/images/<%= review.image %>"
                            alt="<%= review.name %>"
                        >

                        <h3>

                            <%= review.name %>

                        </h3>

                        <p>

                            Bihar Travel provided an amazing travel experience.
                            Everything from hotel booking to sightseeing was
                            perfectly managed.

                        </p>

                        <div class="stars">

                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="far fa-star"></i>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</section>